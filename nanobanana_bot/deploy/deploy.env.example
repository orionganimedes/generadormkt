# Configuración de despliegue de NanoBanana Bot.
# Copiar este archivo a deploy/deploy.env (ignorado por Git) y rellenar los valores.
# Alternativa: exportar las mismas variables en el shell antes de ejecutar deploy.sh.
#
# IMPORTANTE: aquí no van los tokens del bot. El .env de la aplicación vive
# únicamente en el VPS, en $VPS_PROJECT_PATH/nanobanana_bot/.env

# --- Acceso SSH (obligatorio) ---
VPS_HOST=
VPS_PORT=22
VPS_USER=ubuntu
VPS_SSH_KEY=${HOME}/.ssh/id_ed25519
VPS_PROJECT_PATH=/opt/nanobanana_bot

# --- Servicio systemd ---
SERVICE_NAME=nanobanana-bot
RUN_USER=ubuntu
SUDO_CMD=sudo

# --- Estrategia de despliegue ---
# git   -> el VPS hace git fetch/reset de GIT_BRANCH. Permite rollback automático.
# rsync -> copia el árbol local al VPS. Útil para el bootstrap inicial.
DEPLOY_METHOD=git
GIT_BRANCH=main
# 1 = permite desplegar con cambios locales sin commitear (no recomendado).
ALLOW_DIRTY=0

# --- Healthcheck ---
HEALTHCHECK_RETRIES=12
HEALTHCHECK_INTERVAL=5
# 1 = valida el token contra la API de Telegram con getMe.
TELEGRAM_HEALTHCHECK=1
AUTO_ROLLBACK=1
